# Copy to ~/.config/rutec-backup/backup.env on the server and chmod 600 it.
# NEVER commit the real file. Everything is optional; these are the defaults.

# Folder with the server's docker-compose.yml, and the compose service name of MySQL
APP_DIR=$HOME/st_rural_tourism
DB_SERVICE=db

# Where backups are stored: $BACKUP_ROOT/db  (default: inside the app folder)
BACKUP_ROOT=$APP_DIR/rutec-backup

# Local retention, used by cleanup-old-backups.sh
DAILY_KEEP_DAYS=7
# Never delete the newest N backups, however old they are
MIN_KEEP=3
# A backup that is in R2 is deleted after DAILY_KEEP_DAYS. One that never made
# it to R2 is deleted after this many days anyway (and Slack is told). Equal to
# DAILY_KEEP_DAYS = "anything older than 7 days is deleted". Raise it (e.g. 14)
# to keep un-uploaded backups longer while R2 is being fixed.
UPLOAD_GRACE_DAYS=7

# --- Cloudflare R2 (off-site copy). Leave R2_BUCKET empty = local backups only ---
R2_BUCKET=
R2_PREFIX=db
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Encryption password for the backup contents. Must be "obscured" first:
#   docker run --rm rclone/rclone obscure 'the-long-random-password'
# and the ORIGINAL password must also be stored in the password manager.
# Without it the R2 backups can never be read again.
RCLONE_CRYPT_PASSWORD=
# Optional second secret ("salt"), obscured the same way
RCLONE_CRYPT_PASSWORD2=

# Alerts (leave empty to turn off). Use the same webhook as the GitHub deploy
# messages (the SLACK_WEBHOOK_URL secret in GitHub) so backup cards appear in the
# same #deployments channel.
SLACK_WEBHOOK_URL=
# healthchecks.io ping URLs: they alert when a run is missed
HEARTBEAT_BACKUP_URL=
HEARTBEAT_CLEANUP_URL=
SERVER_LABEL=rutec-production
